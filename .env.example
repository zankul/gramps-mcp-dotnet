# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Gramps Web connection (required) ---
GRAMPS_API_URL=https://your-tree.example.com
GRAMPS_USERNAME=
GRAMPS_PASSWORD=

# --- Safety ---
# Master switch for every mutating tool. When false, write tools are not registered at all.
GRAMPS_ALLOW_WRITES=false

# --- Transport ---
# http = one shared server instance, several local clients can reuse it, loopback-bound and
#        unauthenticated by default (see SECURITY.md). stdio = strictly 1:1 with a single client,
#        no network surface at all; preferred for a single desktop client.
MCP_TRANSPORT=http
# Comma-separated Origin allowlist for the http transport, checked against the browser Origin
# header (DNS-rebinding defense). Defaults to the loopback addresses docker-compose.yml binds to.
# Exact string match only — no wildcards, subdomains, or CIDR ranges (e.g. `*`, `*.example.com`,
# 192.168.0.0/24). Anything not a well-formed http(s)://host[:port] value is rejected at startup.
# List every concrete origin needed.
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# None/Critical/Error/Warning/Information/Debug/Trace. Unset preserves current per-transport
# defaults (stdio: Trace to stderr; HTTP: whatever appsettings.json says).
MCP_LOG_LEVEL=

# --- Response shaping ---
GRAMPS_MAX_PAGESIZE=100
# Default pagesize for gramps_search when omitted. Kept well below GRAMPS_MAX_PAGESIZE since each
# hit carries its full raw object (search ignores profile/keys/skipkeys server-side).
GRAMPS_SEARCH_DEFAULT_PAGESIZE=20
GRAMPS_DEFAULT_PROFILE=self,families,events
