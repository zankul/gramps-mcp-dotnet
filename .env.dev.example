# Copy to .env.dev and fill in. .env.dev is gitignored — never commit real credentials.
# Used only by docker-compose.dev.yml, which points gramps-mcp at the local grampsweb
# container it also starts (see that file's top-of-file comment for the staged startup order).

# --- Gramps Web connection (required) ---
# grampsweb is reached over the compose network, not localhost — see docker-compose.dev.yml.
GRAMPS_API_URL=http://grampsweb:5000
# Owner account grampsweb_bootstrap creates automatically on first start.
GRAMPS_USERNAME=owner
GRAMPS_PASSWORD=owner

# --- Safety ---
# This stack exists specifically to exercise write tools against a disposable local tree.
# Never point GRAMPS_ALLOW_WRITES=true at anything but this local grampsweb container.
GRAMPS_ALLOW_WRITES=true
